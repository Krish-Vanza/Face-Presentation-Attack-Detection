        <mxCell id="data" parent="1" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#EAF3FF;strokeColor=#5B8DEF;strokeWidth=2;fontColor=#24364B;fontSize=16;align=center;verticalAlign=middle;spacing=18;shadow=1;" value="&lt;b&gt;&lt;font color=&quot;#5B8DEF&quot;&gt;01  DATA&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;OULU-NPU&lt;/b&gt;&lt;br&gt;1,701 labeled images&lt;br&gt;1,361 train · 340 check&lt;br&gt;&lt;br&gt;&lt;b&gt;CASIA + CelebA&lt;/b&gt;&lt;br&gt;Final tests&lt;br&gt;&lt;br&gt;Replay videos had no labels" vertex="1">
